{
  "data_dir": "../F3_一舱装满_资料包/data",
  "wide_file": "中东大箱体积_渠道子仓_每小时_1001-1020.xlsx",
  "bill_file": "提单_1001-1020提交.xlsx",
  "seed": 20261001,
  "volume_unit": 10000,
  "eval_range": {"start": "2026-10-03 00:00", "end_inclusive_hour": "2026-10-17 23:00"},
  "window_days": 2,
