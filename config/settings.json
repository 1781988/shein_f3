    {"name": "S3_时效优先", "priority_order": ["backlog", "fill", "sensitive", "injection", "cost"]}
  ],
  "scales": [0.25, 0.5, 1.0],
  "enable_reassign": true,
  "strict_no_overwrite": false,
  "extra_csv_columns": false,
  "outputs": {"dir": "results", "allocation": "allocation.csv", "indicators": "indicators.csv"}
}
